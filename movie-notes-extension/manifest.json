{
  "name": "旁白 Aside — 视频灵感记录",
  "description": "看电影、访谈和视频播客时，留下一个观点、一句台词，或你的想法。用视频时间点找回灵感，随时回顾、整理和导出。",
  "version": "1.9.12",
  "manifest_version": 3,
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "tabs",
    "identity",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.bilibili.com/*",
    "*://*.iqiyi.com/*",
    "*://*.youku.com/*",
    "*://*.mgtv.com/*",
    "*://*.v.qq.com/*",
    "https://api.notion.com/*",
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "旁白 Aside",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.bilibili.com/*",
        "*://*.iqiyi.com/*",
        "*://*.youku.com/*",
        "*://*.mgtv.com/*",
        "*://*.v.qq.com/*"
      ],
      "js": [
        "player-dock.js",
        "library-presence.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com;"
  },
  "minimum_chrome_version": "116",
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html",
        "icons/icon32.png",
        "icons/icon128.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+L",
        "mac": "Alt+L"
      }
    },
    "quick-note": {
      "suggested_key": {
        "default": "Alt+N",
        "mac": "Alt+N"
      },
      "description": "打开或收起快速记录"
    }
  }
}
